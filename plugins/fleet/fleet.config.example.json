{
  "repo": "acme/program-host",
  "epic": 1,
  "targets": [
    { "repo": "acme/api", "localPath": "../api", "defaultBranch": "main", "ci": { "gate": "github-actions" } }
  ],
  "workers": {
    "a": { "mode": "local" },
    "b": { "mode": "local" },
    "c": { "mode": "external" }
  },
  "wipCap": 4,
  "approvalEnforcement": "off",
  "worktreesDir": "../api-worktrees",
  "stateDir": "../api-worktrees/.fleet",
  "permissionMode": "acceptEdits",
  "permissionPrompts": "none",
  "maxBudgetUsd": 25,
  "sessionTimeoutMinutes": 120,
  "killGraceSeconds": 60,
  "maxEscalations": 2,
  "noMovementLimit": 3,
  "maxCycleMinutes": 30,
  "models": { "cheapest": "haiku", "default": null, "strongest": "opus" }
}
